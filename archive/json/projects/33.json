0x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-11-768x512.jpg 768w\" sizes=\"auto, (max-width: 961px) 100vw, 961px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"961\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-12.jpg\" class=\"attachment-full size-full\" alt=\"people eating at the Bendigo Jockey Club canteen\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-12.jpg 961w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-12-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-12-768x512.jpg 768w\" sizes=\"auto, (max-width: 961px) 100vw, 961px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"961\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-13.jpg\" class=\"attachment-full size-full\" alt=\"visitors eating at Bendigo Jockey Club cafeteria\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-13.jpg 961w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-13-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-13-768x512.jpg 768w\" sizes=\"auto, (max-width: 961px) 100vw, 961px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"961\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-26.jpg\" class=\"attachment-full size-full\" alt=\"side view of the tower in Bendigo Jockey Club\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-26.jpg 961w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-26-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-26-768x512.jpg 768w\" sizes=\"auto, (max-width: 961px) 100vw, 961px\" \/>                        <\/div>\n\n                    \n                <\/div>\n            \n\n            \n        <\/div>\n\n        <div class=\"swiper-block-nav\">\n            <div class=\"swiper-block-prev\">\n                <svg width=\"25\" height=\"18\" viewBox=\"0 0 28 20\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                    <path d=\"M10.9998 19L2 10.0002L10.9998 1.00049\" stroke=\"#A0A0A0\" stroke-width=\"2\"\/>\n                    <path d=\"M2.19564 10L27.4341 10\" stroke=\"#A0A0A0\" stroke-width=\"2\"\/>\n                <\/svg>\n            <\/div>\n            <div class=\"swiper-block-next\">\n                <svg width=\"25\" height=\"18\" viewBox=\"0 0 28 20\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                    <path d=\"M17.001 1L26.0007 9.99976L17.001 18.9995\" stroke=\"#A0A0A0\" stroke-width=\"2\"\/>\n                    <path d=\"M25.8049 10H0.566406\" stroke=\"#A0A0A0\" stroke-width=\"2\"\/>\n                <\/svg>\n            <\/div>\n        <\/div>\n\n    <\/section>\n\n\n\n","protected":false},"excerpt":{"rendered":"","protected":false},"author":1,"featured_media":415,"parent":0,"menu_order":2,"template":"","meta":{"inline_featured_image":false,"_monsterinsights_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0},"tags":[22],"project_cat":[2],"project_filter":[10],"class_list":["post-33","projects","type-projects","status-publish","has-post-thumbnail","hentry"
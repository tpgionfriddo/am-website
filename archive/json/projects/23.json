{"id":23,"date":"2022-11-21T12:24:49","date_gmt":"2022-11-21T12:24:49","guid":{"rendered":"https:\/\/architecturematters.com.au\/?post_type=projects&#038;p=23"},"modified":"2025-06-03T06:49:55","modified_gmt":"2025-06-03T06:49:55","slug":"romsey-park-community-pavilion","status":"publish","type":"projects","link":"https:\/\/architecturematters.com.au\/project\/romsey-park-community-pavilion\/","title":{"rendered":"Romsey Park Community Pavilion"},"content":{"rendered":"\n\n\n    <section class=\"block block-animate project-info\">\n        <div class=\"grid\">\n            <div class=\"grid__details\"\">\n\n                \n                    \n                        <div>\n                            <h5>Location<\/h5>\n                            <p><p>Romsey, Victoria<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Client<\/h5>\n                            <p><p>Macedon Ranges Shire Council<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Value<\/h5>\n                            <p><p>$1.65 MIL<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Completion<\/h5>\n                            <p><p>May 2013<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Contractor name<\/h5>\n                            <p><p><a href=\"https:\/\/jlcommercial.com.au\" target=\"_blank\" rel=\"noopener\">Johns Lyng Commercial Builders<\/a><\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Subconsultants<\/h5>\n                            <p><p>Structural &amp; Civil Engineer &#8211; Keith Long and Associates,<br \/>\nServices Engineer &#8211; <a href=\"https:\/\/www.njmdesign.com.au\" target=\"_blank\" rel=\"noopener\">NJM Design<\/a>,<br \/>\nBuilding Surveyor &#8211; <a href=\"https:\/\/www.metrobuildingsurveying.com.au\" target=\"_blank\" rel=\"noopener\">Metro Building Surveyors<\/a><\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<p>&nbsp;<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Photographer<\/h5>\n                            <p><p><a href=\"https:\/\/www.yelp.com\/biz\/christopher-alexander-photography-blackburn\" target=\"_blank\" rel=\"noopener\">Christopher Alexander Photography<\/a><\/p>\n<\/p>\n                        <\/div>\n\n                    \n                \n                \n                \n                                \n                \n                \n                \n                \n            <\/div>\n            <div class=\"grid__text\">\n                <p><span style=\"font-weight: 400;\">The pulsing heart of any small community is its social sporting hub so getting it right matters. To Melbourne\u2019s northwest in the Macedon Ranges, the Romsey community had been making do with ageing facilities that were no longer fit-for-purpose. Macedon Ranges Shire Council engaged us to design and deliver the Romsey Sports and Community Pavilion \u2014 a structure suitable for hosting a range of sporting codes that would give local sport a new lease on life.\u00a0<\/span><\/p>\n<p><span style=\"font-weight: 400;\">The project was required to address the diverse needs and aspirations of Romsey\u2019s senior and junior Australian rules football, cricket, tennis and little athletics clubs.<\/span><\/p>\n            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate full-width-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"1320\" height=\"879\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9470-1-5.jpg\" class=\"attachment-full size-full\" alt=\"Romsey Park\u2019s football field with children playing\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9470-1-5.jpg 1320w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9470-1-5-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9470-1-5-1024x682.jpg 1024w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9470-1-5-768x511.jpg 768w\" sizes=\"auto, (max-width: 1320px) 100vw, 1320px\" \/>    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate block-quote\">\n        <div class=\"max-sm:w-full ml-auto w-1\/2\">\n            <div>\n                <blockquote>\n\n                <p><b>Local resident and Architecture Matters\u2019 director Anthony Quigley, a Romsey resident, hosted a series of informal backyard barbeque consultations to align all stakeholders around a shared vision. <\/b><\/p>\n\n                \n                <\/blockquote>\n            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate two-thirds-image\">\n        <div class=\"grid\">\n            <div>\n                <img loading=\"lazy\" decoding=\"async\" width=\"853\" height=\"569\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-1-5.jpg\" class=\"attachment-full size-full\" alt=\"Romsey Park\u2019s glass doors\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-1-5.jpg 853w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-1-5-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9574-1-5-768x512.jpg 768w\" sizes=\"auto, (max-width: 853px) 100vw, 853px\" \/>            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate two-columns-text-image\">\n        \n        \n                \n        <div class=\"grid mt-[30px] md:mt-[50px]\">\n            <div class=\"grid__text space-y-12\">\n                <div><p><span style=\"font-weight: 400;\">The pavilion combines highly adaptable change rooms suitable for male, female, children and adult players, a large social space and a covered external area for viewing the action on the field.\u00a0<\/span><\/p>\n<\/div>\n                            <\/div>\n            <div class=\"grid__image\">\n                 <img loading=\"lazy\" decoding=\"async\" width=\"620\" height=\"744\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9660-1-5.jpg\" class=\"attachment-full size-full\" alt=\"Romsey Park Community Pavilion\u2019s rubber floor interior\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9660-1-5.jpg 620w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9660-1-5-250x300.jpg 250w\" sizes=\"auto, (max-width: 620px) 100vw, 620px\" \/>            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate full-width-image\">\n        <img loading=\"lazy\" decoding=\"async\" width=\"1320\" height=\"880\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9645-1-5.jpg\" class=\"attachment-full size-full\" alt=\"Student\u2019s posing in front of the Romsey Park Community Pavilion entrance\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9645-1-5.jpg 1320w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9645-1-5-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9645-1-5-1024x683.jpg 1024w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9645-1-5-768x512.jpg 768w\" sizes=\"auto, (max-width: 1320px) 100vw, 1320px\" \/>    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate two-columns-text\">\n        <div class=\"grid\">\n            <div class=\"grid__text\">\n                            <\/div>\n            <div class=\"grid__text space-y-12\">\n                <div>\n                    <p><span style=\"font-weight: 400;\">Our simple building form, durable yet efficient detailing and comprehensive documentation resulted in a below-budget construction tender, enabling the social space to be increased in scale. This was considered a real win by the various user groups.<\/span><\/p>\n                <\/div>\n                            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate project-carousel\">\n\n        <div class=\"swiper swiper-block\">\n\n            \n                <div class=\"swiper-wrapper\">\n                    \n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9325-1-1.png\" class=\"attachment-full size-full\" alt=\"Romsey Park Community Pavilion\u2019s facade side view\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9325-1-1.png 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9325-1-1-300x200.png 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9325-1-1-768x512.png 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-12.jpg\" class=\"attachment-full size-full\" alt=\"Romsey Park Community Pavilion\u2019s facade\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-12.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-12-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-12-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-13.jpg\" class=\"attachment-full size-full\" alt=\"Romsey Park\u2019s football field with a view of the pavilion\u2019s entrance\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-13.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-13-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-13-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-14.jpg\" class=\"attachment-full size-full\" alt=\"\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-14.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-14-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-14-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\
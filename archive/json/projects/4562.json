{"id":4562,"date":"2025-10-27T23:16:31","date_gmt":"2025-10-27T23:16:31","guid":{"rendered":"https:\/\/architecturematters.com.au\/?post_type=projects&#038;p=4562"},"modified":"2025-11-04T23:19:24","modified_gmt":"2025-11-04T23:19:24","slug":"ballarat-regional-animal-facility","status":"publish","type":"projects","link":"https:\/\/architecturematters.com.au\/project\/ballarat-regional-animal-facility\/","title":{"rendered":"Ballarat Regional Animal Facility"},"content":{"rendered":"\n\n\n    <section class=\"block block-animate project-info\">\n        <div class=\"grid\">\n            <div class=\"grid__details\"\">\n\n                \n                    \n                        <div>\n                            <h5>Location<\/h5>\n                            <p><p>Mitchell Park, Victoria<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Client<\/h5>\n                            <p><p>Ballarat City Council<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Value<\/h5>\n                            <p><p>$14.25 MIL<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Timeframe<\/h5>\n                            <p><p>2024-2027<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Contractor<\/h5>\n                            <p><p>TBC<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                        <div>\n                            <h5>Consultant team<\/h5>\n                            <p><p>Structural &amp; Civil Engineer &#8211; <a href=\"http:\/\/www.adamseng.com.au\/\" target=\"_blank\" rel=\"noopener\">Adams Consulting Engineers<\/a><\/p>\n<p>Services Engineer &#8211; <a href=\"http:\/\/www.brt.com.au\/\" target=\"_blank\" rel=\"noopener\">BRT Consulting<\/a><\/p>\n<p>Quantity Surveyor &#8211; <a href=\"http:\/\/www.prowseqs.com.au\/\" target=\"_blank\" rel=\"noopener\">Prowse Quantity Surveyors<\/a><\/p>\n<p>Relevant Building Surveyor &#8211; <a href=\"https:\/\/lhbp.com.au\/\" target=\"_blank\" rel=\"noopener\">Lighthouse Building Permits<\/a><\/p>\n<p>Consultant Building Surveyor &#8211; <a href=\"http:\/\/www.duchateauchun.com\/\" target=\"_blank\" rel=\"noopener\">du Chateau Chun<\/a><\/p>\n<p>ESD Consultant &#8211; <a href=\"https:\/\/salt3.com.au\/\" target=\"_blank\" rel=\"noopener\">SALT3<\/a><\/p>\n<p>Access Consultant &#8211; <a href=\"http:\/\/www.disabilityaccessconsultants.com.au\/\" target=\"_blank\" rel=\"noopener\">Equal Access<\/a><\/p>\n<p>Acoustic Engineer &#8211; <a href=\"https:\/\/www.enfieldacoustics.com.au\/\" target=\"_blank\" rel=\"noopener\">Enfield Acoustics<\/a><\/p>\n<p>Landscape Architect &#8211; Leftfield Design<\/p>\n<p>Geotechnical Engineer &#8211; <a href=\"https:\/\/www.pgvic.com.au\/\" target=\"_blank\" rel=\"noopener\">Provincial Geotechnical<\/a><\/p>\n<p>Bushfire Assessment &#8211; Keystone Alliance<\/p>\n<p>&nbsp;<\/p>\n<\/p>\n                        <\/div>\n\n                    \n                \n                \n                \n                                \n                \n                \n                \n                \n            <\/div>\n            <div class=\"grid__text\">\n                <p>Professional services for the design and delivery of a new Regional Animal Facility in Mitchell Park enhancing the quality of life and care delivered to thousands of animals from around the greater Ballarat region that pass through the shelter each year, with a plan to house over 50 dogs and over 130 cats, as well as small animals and livestock.<\/p>\n            <\/div>\n        <\/div>\n    <\/section>\n\n\n\n\n\n\n\n\n    <section class=\"block block-animate full-width-image\">\n        <img loading=\"lazy\" decod
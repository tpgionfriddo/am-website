false},"author":1,"featured_media":135,"parent":0,"menu_order":16,"template":"","meta":{"inline_featured_image":false,"_monsterinsights_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0},"tags":[22],"project_cat":[2],"project_filter":[],"class_list":["post-24","projects","type-projects","status-publish","has-post-thumbnail","hentry","tag-community"],"acf":[],"yoast_head":"<!-- This site is optimized with the Yoast SEO plugin v26.3 - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>Montrose Town Centre - Architecture Matters<\/title>\n<meta name=\"description\" content=\"Montrose Town Centre, a vibrant community hub that perfectly integrates with the surrounding buildings and prioritizes both functionality and community-focused features.\" \/>\n<meta name=\"robots\" content=\"index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1\" \/>\n<link rel=\"canonical\" href=\"https:\/\/architecturematters.com.au\/project\/montrose-town-centre\/\" \/>\n<meta property=\"og:locale\" content=\"en_US\" \/>\n<meta property=\"og:type\" content=\"article\" \/>\n<meta property=\"og:title\" content=\"Montrose Town Centre - Architecture Matters\" \/>\n<meta property=\"og:description\" content=\"Montrose Town Centre, a vibrant community hub that perfectly integrates with the surrounding buildings and prioritizes both functionality and community-focused features.\" \/>\n<meta property=\"og:url\" content=\"https:\/\/architecturematters.com.au\/project\/montrose-town-centre\/\" \/>\n<meta property=\"og:site_name\" content=\"Architecture Matters\" \/>\n<meta property=\"article:publisher\" content=\"https:\/\/www.facebook.com\/people\/Architecture-Matters-Pty-Ltd\/100039303281766\/\" \/>\n<meta property=\"article:modified_time\" content=\"2025-06-03T06:44:48+00:00\" \/>\n<meta property=\"og:image\" content=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\
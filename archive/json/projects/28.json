x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-53.jpg\" class=\"attachment-full size-full\" alt=\"\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-53.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-53-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-53-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-54.jpg\" class=\"attachment-full size-full\" alt=\"Exford Primary School\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-54.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-54-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-54-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-55.jpg\" class=\"attachment-full size-full\" alt=\"\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2022\/11\/69A9496-55.jpg 962w, https:\/\/architectur
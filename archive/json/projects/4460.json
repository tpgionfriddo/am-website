4-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1159.jpg\" class=\"attachment-full size-full\" alt=\"Contemporary Eco-Home in Romsey laundry\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1159.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1159-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1159-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                                        \n                        <div class=\"swiper-slide\">\n                            <img loading=\"lazy\" decoding=\"async\" width=\"962\" height=\"641\" src=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1377.jpg\" class=\"attachment-full size-full\" alt=\"Contemporary Eco-Home in Romsey al fresco area\" srcset=\"https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1377.jpg 962w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1377-300x200.jpg 300w, https:\/\/architecturematters.com.au\/wp-content\/uploads\/2025\/02\/43A1377-768x512.jpg 768w\" sizes=\"auto, (max-width: 962px) 100vw, 962px\" \/>                        <\/div>\n\n                    \n                <\/div>\n            \n\n            \n        <\/div>\n\n        <div class=\"swiper-block-nav\">\n            <div class=\"swiper-block-prev\">\n                <svg width=\"25\" height=\"18\" viewBox=\"0 0 28 20\" fill=\"none\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\">\n                    <path d=\"M10.9998 19L2 10.0002L10.9998 1.00049\" stroke=\"#A0A0A0\" strok
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "architecturematters-site",
	// Adept's Cloudflare account for Architecture Matters (not their production account)
	"account_id": "a2bcaec6c865d7951e765fc7611d87e8",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "architecturematters-site",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "architecturematters-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger (scheduled publishing, backups, plugin tasks)
	"triggers": {
		"crons": ["* * * * *"],
	},
	"observability": { "enabled": true },
	// Secrets (wrangler secret put): EMDASH_ENCRYPTION_KEY, SETUP_KEY (delete after setup)
}

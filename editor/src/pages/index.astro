---
import Editor from "../components/Editor";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Architecture Matters — Content editor</title>
		<script is:inline>
			if (window.location.pathname === "/") {
				window.location.replace(`/keystatic${window.location.search}${window.location.hash}`);
			}
		</script>
	</head>
	<body>
		<Editor client:only="react" />
		<noscript>Enable JavaScript to use the Architecture Matters content editor.</noscript>
	</body>
</html>

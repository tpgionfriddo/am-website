---
import { Image } from "emdash/ui";
interface Props { project: any; }
const { project } = Astro.props;
const image = project.data.thumbnail ?? project.data.featured_image;
---
<div class="block-loop">
	<a href={`/project/${project.id}/`} title={project.data.title} class="block-loop__link">
		<div class="block-loop__image">{image && <Image image={image} class="attachment-large size-large" sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw" />}</div>
		<div class="block-loop__heading">
			<h4>{project.data.title}</h4>
			<svg width="33" height="24" viewBox="0 0 35 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21.323 1L32.9999 12.6769L21.323 24.3539" stroke="#A0A0A0" stroke-width="2"></path><path d="M32.7462 12.677H0" stroke="#A0A0A0" stroke-width="2"></path></svg>
		</div>
	</a>
</div>

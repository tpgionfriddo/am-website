---
import Image from "../Image.astro";
import { renderText } from "../../lib/text";
const { value } = Astro.props;
const items = (value.items ?? []) as any[];
const sectionId = `accordion-${crypto.randomUUID()}`;
---
<section class="block block-animate accordion-section">
	{value.heading && <h2>{value.heading}</h2>}
	<div class="grid">
		<div class="grid__image">
			<div class="accordion__images">
				{
					items.map((item, index) => (
						<div class:list={["accordion__image", { "is-active": index === 0 }]} data-index={index} aria-hidden={index !== 0}>
							{item.image && <Image image={item.image} class="attachment-full size-full" sizes="(min-width: 768px) 50vw, 100vw" />}
						</div>
					))
				}
			</div>
		</div>
		<div class="grid__text">
			<div class="accordion">
				{
					items.map((item, index) => (
						<div class:list={["accordion__item", { "is-active": index === 0 }]}>
							<h4 class="accordion__title">
								<button id={`${sectionId}-button-${index}`} type="button" class:list={["accordion__button", { "is-active": index === 0 }]} data-index={index} aria-controls={`${sectionId}-panel-${index}`} aria-expanded={index === 0 ? "true" : "false"}>
									<span>{item.title}</span>
									<svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
										<path class="accordion__arrow-closed" d="M3 14H24M15 5L24 14L15 23" stroke="currentColor" stroke-width="2" />
										<path class="accordion__arrow-open" d="M14 3V24M5 15L14 24L23 15" stroke="currentColor" stroke-width="2" />
									</svg>
								</button>
							</h4>
							<div id={`${sectionId}-panel-${index}`} class="accordion__content" role="region" aria-labelledby={`${sectionId}-button-${index}`} inert={index !== 0}>
								<div class="accordion__panel"><div class="accordion__body" set:html={renderText(item.text)} /></div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

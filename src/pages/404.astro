---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="Page not found" bodyClass="error404 no-thumbnail">
	<main id="primary" class="site-main site-404">
		<div class="container site-404__container">
			<div class="site-404__wrapper">
				<h1>Page not found</h1>
				<p>Sorry, we couldn't find that page.</p>
				<p><a href="/">Return to the home page</a> or <a href="/australian-architecture/">see our projects</a>.</p>
			</div>
		</div>
	</main>
</Base>

---
import { getEntry, getSeoMeta } from "../lib/content";
import Blocks from "../components/Blocks.astro";
import { blockComponents } from "../components/blocks";
import Base from "../layouts/Base.astro";
const { entry: page } = await getEntry("pages", "home");
if (!page) throw new Error("A published home page is required");
const seo = getSeoMeta(page, { path: "/" });
---
<Base title="" description={seo.description} canonical={seo.canonical} image={seo.ogImage} bodyClass="home" hideFooter><main id="primary"><Blocks value={page.data.layout} components={blockComponents} /></main></Base>

---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { Blocks } from "emdash/ui";
import { blockComponents } from "../components/blocks";
import Base from "../layouts/Base.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const seo = page ? getSeoMeta(page, { siteTitle: "Architecture Matters", siteUrl: "https://architecturematters.com.au", path: "/" }) : null;
---
<Base title="" description={seo?.description} bodyClass="home" hideFooter content={page ? { collection: "pages", id: page.data.id, slug: "home" } : undefined}>
	{page ? <Blocks value={page.data.layout ?? []} components={blockComponents} /> : <main id="primary" class="container" style="padding:10rem 1.25rem"><h1>Architecture Matters</h1><p>Create a page with the slug <code>home</code> in the admin.</p></main>}
</Base>

---
import { getCollection, getTerms } from "../../lib/content";
import NewsListView from "../../views/NewsListView.astro";
export async function getStaticPaths() {
 const paths = [];
 for (const term of getTerms("category")) {
  const posts = await getCollection("posts", { where: { category: term.slug } });
  for (let page = 1; page <= Math.max(1, Math.ceil(posts.entries.length / 8)); page++) paths.push({ params: { path: page === 1 ? term.slug : term.slug + "/page/" + page }, props: { term, page } });
 }
 return paths;
}
const { term, page } = Astro.props;
---
<NewsListView title={term.label} category={term.slug} page={page} basePath={"/category/" + term.slug + "/"} />

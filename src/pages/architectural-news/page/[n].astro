---
import { getCollection, getEntry } from "../../../lib/content";
import NewsListView from "../../../views/NewsListView.astro";
export async function getStaticPaths() {
 const posts = await getCollection("posts");
 const { entry: page } = await getEntry("pages", "architectural-news");
 return Array.from({ length: Math.max(0, Math.ceil(posts.entries.length / 8) - 1) }, (_unused, index) => ({ params: { n: String(index + 2) }, props: { title: page?.data.title || "Practice News", page: index + 2 } }));
}
const { title, page } = Astro.props;
---
<NewsListView title={title} page={page} basePath="/architectural-news/" />

---
import { getCollection, getSeoMeta } from "../lib/content";
import NewsListView from "../views/NewsListView.astro";
import PageView from "../views/PageView.astro";
import PostView from "../views/PostView.astro";
import ProjectsIndexView from "../views/ProjectsIndexView.astro";
export async function getStaticPaths() {
 const pages = await getCollection("pages");
 const posts = await getCollection("posts");
 const entries = [...pages.entries.filter((entry) => entry.id !== "home").map((entry) => ({ entry, kind: "page" })), ...posts.entries.map((entry) => ({ entry, kind: "post" }))];
 if (new Set(entries.map(({ entry }) => entry.id)).size !== entries.length) throw new Error("Page and article slugs must be unique");
 return entries.map(({ entry, kind }) => ({ params: { slug: entry.id }, props: { entry, kind } }));
}
const { entry, kind } = Astro.props;
const path = "/" + entry.id + "/";
const seo = getSeoMeta(entry, { path });
---
{kind === "post" ? <PostView post={entry} /> : entry.id === "architectural-news" ? <NewsListView title={entry.data.title} description={seo.description} page={1} basePath="/architectural-news/" /> : entry.id === "australian-architecture" ? <ProjectsIndexView page={entry} path={path} /> : <PageView page={entry} path={path} />}

---
import { getCollection } from "../../lib/content";
import PageView from "../../views/PageView.astro";
export async function getStaticPaths() {
 return (await getCollection("pages")).entries.filter((page) => page.data.layout.some((block: any) => block.discriminant === "project_list")).map((page) => ({ params: { slug: page.id }, props: { page } }));
}
const { page } = Astro.props;
---
<PageView page={page} path={"/australian-architecture/" + page.id + "/"} />

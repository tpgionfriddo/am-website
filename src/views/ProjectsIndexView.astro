---
import { getSeoMeta } from "../lib/content";
import Blocks from "../components/Blocks.astro";
import { blockComponents } from "../components/blocks";
import Base from "../layouts/Base.astro";

/** "Our Projects" (template-projects.php): title + project-type tiles. */
interface Props { page: any; path: string; }
const { page, path } = Astro.props;
const seo = getSeoMeta(page, { siteTitle: "Architecture Matters", siteUrl: "https://architecturematters.com.au", path });
---
<Base title={page.data.title} description={seo.description} canonical={seo.canonical} bodyClass="page page-template-template-projects no-thumbnail">
	<main id="primary" class="site-main">
		<section class="our-projects">
			<div class="container block-animate"><h1>{page.data.title}</h1></div>
			<Blocks value={page.data.layout ?? []} components={blockComponents} />
		</section>
	</main>
</Base>

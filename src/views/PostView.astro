---
import { getSeoMeta } from "../lib/content";
import Image from "../components/Image.astro";
import ArticleBody from "../components/ArticleBody.astro";
import BackLink from "../components/BackLink.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import SharePost from "../components/SharePost.astro";
import Base from "../layouts/Base.astro";
interface Props { post: any; }
const { post } = Astro.props;
const seo = getSeoMeta(post, { path: "/" + post.id + "/" });
const banner = post.data.featured_image;
---
<Base title={post.data.title} description={seo.description} canonical={seo.canonical} image={seo.ogImage} pageType="article" bodyClass={"single single-post" + (banner?.src ? "" : " no-thumbnail")}>
 <main id="primary" class="site-main"><article class="post type-post">
  {banner?.src && <div class="entry-thumbnail"><Image image={banner} class="attachment-full size-full wp-post-image" sizes="100vw" priority /></div>}
  <header class="block-animate entry-header"><div class="container entry-header__container"><h1 class="entry-title">{post.data.title}</h1></div></header>
  <div class="entry-content"><div class="container single-post__grid">
   <div class="single-post__sidebar"><SharePost title={post.data.title} /><BackLink href="/architectural-news/" /></div>
   <div class="single-post__content block-wrapper"><ArticleBody value={post.data.content} /></div>
   <BackLink href="/architectural-news/" />
  </div><div class="container block-animate"><RelatedPosts heading="Practice News" count={2} exclude={post.id} /></div></div>
 </article></main>
</Base>

		},
		{
			"discriminant": "quote",
			"value": {
				"text": "Working with the existing infrastructure, we provided workstations for fifty people, a series of breakout spaces, a dedicated twelve person meeting room and a large fifty person conference facility equipped with virtual meeting technology and associated kitchen and gathering space adjacent."
			}
		},
		{
			"discriminant": "image_two_thirds",
